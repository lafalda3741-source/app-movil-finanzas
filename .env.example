# Copiá este archivo como ".env" y completá con los datos de tu proyecto en supabase.com
# (Configuración del proyecto → API) — usá el MISMO proyecto que el Panel de Control.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# "ariel" o "cielo" — define el nombre, color y las 2 tarjetas propias que ve
# esta instalación en "Carga de Compras". Cada celular necesita su propio
# deploy con este valor distinto.
VITE_PERSONA=ariel
